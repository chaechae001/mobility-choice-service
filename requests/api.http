### 서버 상태 확인
GET http://localhost:4000/api/health

### 회원가입
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "userId": "chaeeun_01",
  "password": "testpass123"
}

### 로그인
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "userId": "chaeeun_01",
  "password": "testpass123"
}

> {%
    client.global.set("token", response.body.token);
%}

### 로그인 사용자 확인
GET http://localhost:4000/api/auth/me
Authorization: Bearer {{token}}

### 게시글 작성
POST http://localhost:4000/api/posts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "서울 출퇴근용 첫 차 선택 계획",
  "content": "평일 왕복 30km 출퇴근과 주말 근거리 이동에 적합한 차량을 찾고 있습니다."
}

> {%
    if (response.status === 201) {
        client.global.set("postId", response.body._id);
    }
%}

### 게시글 목록 조회
GET http://localhost:4000/api/posts

### 게시글 상세 조회
GET http://localhost:4000/api/posts/{{postId}}

### 게시글 수정
PATCH http://localhost:4000/api/posts/{{postId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "서울 출퇴근용 첫 차 선택 계획 - 수정",
  "content": "하이브리드 차량을 우선 탐색하고 있습니다."
}

### 게시글 삭제
DELETE http://localhost:4000/api/posts/{{postId}}
Authorization: Bearer {{token}}

###

### 모빌리티 선택 계획 작성
POST http://localhost:4000/api/plans
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "서울 출퇴근용 첫 차 선택 계획",
  "purpose": "평일 출퇴근과 주말 근거리 이동",
  "budget": 3000,
  "passengers": 1,
  "drivingPattern": "평일 왕복 30km, 월 1회 장거리 이동",
  "parkingEnvironment": "아파트 지하주차장",
  "chargingEnvironment": "상시 충전 어려움",
  "preferredUsageType": "신차 또는 인증중고차",
  "priorities": ["연비", "주차 편의성", "안전성"],
  "notes": "하이브리드 차량을 우선 고려합니다."
}