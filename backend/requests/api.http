### 서버 상태 확인
GET http://localhost:4000/api/health

### 회원가입
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "userId": "chaeeun_01",
  "password": "testpass123"
}

### 로그인
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "userId": "chaeeun_01",
  "password": "testpass123"
}

> {%
    client.global.set("token", response.body.token);
%}

### 로그인 사용자 확인
GET http://localhost:4000/api/auth/me
Authorization: Bearer {{token}}

### 모빌리티 선택 계획 작성
POST http://localhost:4000/api/plans
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "서울 출퇴근용 첫 차 선택 계획",
  "purpose": "평일 출퇴근과 주말 근거리 이동",
  "budget": 3000,
  "passengers": 1,
  "drivingPattern": "평일 왕복 30km, 월 1회 장거리 이동",
  "parkingEnvironment": "아파트 지하주차장",
  "chargingEnvironment": "상시 충전 어려움",
  "preferredUsageType": "신차 또는 인증중고차",
  "priorities": ["연비", "주차 편의성", "안전성"],
  "notes": "하이브리드 차량을 우선 고려합니다."
}

### 내 모빌리티 선택 계획 목록 조회
GET http://localhost:4000/api/plans
Authorization: Bearer {{token}}

> {%
    if (response.status === 200 && response.body.length > 0) {
        client.global.set("planId", response.body[0]._id);
    }
%}

### 모빌리티 선택 계획 상세 조회
GET http://localhost:4000/api/plans/{{planId}}
Authorization: Bearer {{token}}

### 모빌리티 선택 계획 수정
PATCH http://localhost:4000/api/plans/{{planId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "budget": 3500,
  "priorities": ["연비", "주차 편의성", "안전성", "유지비"],
  "notes": "하이브리드와 인증중고차를 함께 비교합니다."
}

### 모빌리티 선택 계획 삭제
DELETE http://localhost:4000/api/plans/{{planId}}
Authorization: Bearer {{token}}